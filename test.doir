// 	i_v : std.u64 = std.pointers.load(i)
// 	bumped : std.u64 = std.add(i_v, one)
// 	_ : _ = std.pointers.store(i, bumped)
// }
// for_body : block = {
// 	i_v : std.u64 = std.pointers.load(i)
// 	_ : std.u64 = std.debug_print(i_v)
// }
// _ : void = std.for(for_init, for_cond, for_step, for_body)

after_addr : std.u64 = std.find_label(after)
_ : _ = std.jump_to(after_addr)
	skipped : std.u64 = 999
	_ : std.u64 = mizu.load_immediate(std.u64, skipped)
	_ : std.u64 = std.debug_print(skipped)
after : compiler.assembler.register = std.label()

_ : _ = std.halt()
