path : compiler.byte_pointer = "./standard.mizu.doir"
_ : compiler.byte = early_include(path)
_ : compiler.assembler.register = compiler.assembler.begin_register_allocation()

u64 : alias = mizu.u64
u1 : alias = mizu.u64

blk : block = {
	q : u64 = 1234
	_ : u64 = mizu.load_immediate(u64, q)
	_ : u64 = compiler.assembler.pin_register(u64, q, mizu.x1)
	_ : u64 = std.debug_print(q)
}
true : u64 = 1
ran : u64 = std.execute_if(blk, true)

a : u64 = 5
_ : u64 = mizu.load_immediate(u64, a)
b : u64 = 6
_ : u64 = mizu.load_immediate(u64, b)
c : u64 = std.add(a, b)
d : u64 = 7
_ : u64 = mizu.load_immediate(u64, d)
e : u64 = std.subtract(c, d)
_ : u64 = std.debug_print(e)
_ : u64 = compiler.assembler.pin_register(u64, c, mizu.x3)
_ : u64 = compiler.assembler.pin_register(u64, e, mizu.x4)

then_blk : block = {
	x : u64 = 111
	_ : u64 = mizu.load_immediate(u64, x)
	_ : u64 = std.debug_print(x)
}
else_blk : block = {
	y : u64 = 222
	_ : u64 = mizu.load_immediate(u64, y)
	_ : u64 = std.debug_print(y)
}

cond : u1 = 1
_ : u1 = mizu.load_immediate(u1, cond)
r_if : u64 = std.if(cond, then_blk, else_blk)

body : block = {
	one : u64 = 1
	_ : u64 = mizu.load_immediate(u64, one)
	next : u64 = std.subtract(n, one)
	_ : _ = compiler.assembler.pin_register(u64, next, mizu.x2)
	_ : u64 = std.debug_print(next)
}

n : u64 = 3
_ : u64 = mizu.load_immediate(u64, n)
_ : _ = compiler.assembler.pin_register(u64, n, mizu.x2)
r_while : u64 = std.while(n, body)

after_addr : u64 = std.find_label(after)
_ : _ = std.jump_to(after_addr)
	skipped : u64 = 999
	_ : u64 = mizu.load_immediate(u64, skipped)
	_ : u64 = std.debug_print(skipped)
after : compiler.assembler.register = std.label()

_ : _ = std.halt()
