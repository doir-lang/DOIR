path : compiler.byte_pointer = "./standard.mizu.doir"
_ : compiler.byte = early_include(path)
_ : compiler.assembler.register = compiler.assembler.begin_register_allocation()

blk : block = {
	q : std.u64 = 1234
	_ : std.u64 = mizu.load_immediate(std.u64, q)
	_ : std.u64 = compiler.assembler.pin_register(std.u64, q, mizu.x1)
	_ : std.u64 = std.debug_print(q)
}
true : std.u64 = 1
ran : std.u64 = std.execute_if(blk, true)

a : std.u64 = 5
_ : std.u64 = mizu.load_immediate(std.u64, a)
b : std.u64 = 6
_ : std.u64 = mizu.load_immediate(std.u64, b)
c : std.u64 = std.add(a, b)
d : std.u64 = 7
_ : std.u64 = mizu.load_immediate(std.u64, d)
e : std.u64 = std.subtract(c, d)
_ : std.u64 = std.debug_print(e)
_ : std.u64 = compiler.assembler.pin_register(std.u64, c, mizu.x3)
_ : std.u64 = compiler.assembler.pin_register(std.u64, e, mizu.x4)

then_blk : block = {
	x : std.u64 = 111
	_ : std.u64 = mizu.load_immediate(std.u64, x)
	_ : std.u64 = std.debug_print(x)
}
else_blk : block = {
	y : std.u64 = 222
	_ : std.u64 = mizu.load_immediate(std.u64, y)
	_ : std.u64 = std.debug_print(y)
}

cond : std.u1 = 1
_ : std.u1 = mizu.load_immediate(std.u1, cond)
_ : void = std.if(cond, then_blk, else_blk) // TODO: Why can't we deduce this type?

// The counter is the caller's, pinned, because `condition` and `body` are
// spliced at two different points and share nothing else: `body` recomputes
// into `x2` and `condition` tests whatever is there.
body : block = {
	one : std.u64 = 1
	_ : std.u64 = mizu.load_immediate(std.u64, one)
	next : std.u64 = std.subtract(n, one)
	_ : _ = compiler.assembler.pin_register(std.u64, next, mizu.x2)
	_ : std.u64 = std.debug_print(next)
}
loop_cond : block = {
	zero : std.u64 = 0
	_ : std.u64 = mizu.load_immediate(std.u64, zero)
	more : std.u1 = std.is_not_equal(n, zero)
	_ : std.u1 = std.yield(more)
}

n : std.u64 = 3
_ : std.u64 = mizu.load_immediate(std.u64, n)
_ : _ = compiler.assembler.pin_register(std.u64, n, mizu.x2)
_ : void = std.while(loop_cond, body) // TODO: Why can't we deduce this type?

// // `for`: the same sharing, with the counter's init and step in blocks of
// // their own. Prints 0, 1, 2.
