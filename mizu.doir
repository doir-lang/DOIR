	// The register classes, which the compiler does not get to decide. Two
	// registers are in no class at all and so never handed out: x0 reads as
	// zero on every Mizu machine, and x21 (`ra`) holds the return address a
	// `jump_to` left in it. That is what makes the allocatable set
	// discontiguous, and why each class is declared as its own range.
	_ : compiler.assembler.register = compiler.assembler.caller_saved_registers(t0, t19)
	// Eight argument registers, which is a choice rather than a property of
	// the machine - `Registers.a(i)` goes on as far as the register file does.
	_ : compiler.assembler.register = compiler.assembler.argument_registers(a0, a7)
	// The rest of the argument space, used as callee-saved scratch.
	_ : compiler.assembler.register = compiler.assembler.callee_saved_registers(a8, a234)

	schedule : compiler.byte_pointer = """
		sequential(
			depthFirst(nameReuse),
			depthFirst(functionArity),
			// The post-comptime half of the type system. Scheduled here rather
			// than by the compiler so a backend can say something else: drop
			// these two lines and nothing type checks, replace them and the
			// rules change with the backend.
			//
			// `foldBaseTypes` first: S-Struct compares two types by their layout,
			// and every builtin type is a `base_type` call until something folds
			// it. Without this line `typeCheck` reads no layout on either side and
			// so agrees with everything.
			breadthFirst(foldBaseTypes),
			depthFirst(typeCheck),
			depthFirst(computeTypeProperties),
			depthFirst(runSchedule),
			runRegisteredSchedules,

			applyGlobally(sequential(
				sort,
				depthFirst(pinRegisters),
				breadthFirst(computeAllocatorInputs),
				assignTemporaries,
				depthFirst(pinRegisters)
			)),

			breadthFirst(computeCompilerNamespace!false),
			depthFirst(materializeImmediates),
			depthFirst(materializeLabels),
			sorted(monomorphizeFunctions, false),
			breadthFirst(inlineFunctions),
			breadthFirst(computeCompilerNamespace!true),
			//debugPrint
		)
	"""
	_ : compiler.pointer_sized = compiler.run_schedule(schedule)
}

_ : compiler.pointer_sized = compiler.override_fallback_schedule(mizu.schedule)
_ : mizu.u64 = compiler.assembler.begin_register_allocation()
