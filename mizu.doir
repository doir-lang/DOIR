mizu : namespace = {

	%64 : compiler.pointer_sized = 64
	u64 : type = compiler.base_type(%64, %64)
	comptime : namespace = {
		u64 : type = compiler.comptime_base_type(%64, %64)
	}

	zero_parameters_t : type = () -> u64
	_ : type = compiler.always_inline(zero_parameters_t)
	one_parameters_t : type = (a : u64) -> u64
	_ : type = compiler.always_inline(one_parameters_t)
	two_parameters_t : type = (a : u64, b : u64) -> u64
	_ : type = compiler.always_inline(two_parameters_t)
	// These three take a comptime parameter but have nothing to gain from a body
	// of their own for each value of it: every copy would emit the same
	// instruction with one immediate changed, and there are 2^64 immediates and
	// 256 registers. `always_inline` already gives the call site the copy it
	// wants; monomorphizing first would only make a declaration to inline from.
	immediate_t : type = (immediate: comptime.u64) -> u64
	_ : type = compiler.always_inline(immediate_t)
	_ : type = compiler.never_monomorphize(immediate_t)
	branch_immediate_t : type = (a: u64, immediate: comptime.u64) -> u64
	_ : type = compiler.always_inline(branch_immediate_t)
	_ : type = compiler.never_monomorphize(branch_immediate_t)

	// The same five shapes again for the instructions whose result is machine
	// state rather than a value - see `effectOps`. Separate types rather than a
	// flag on the call, because whether a call may be folded is a property of
	// its callee, and a type is where the compiler looks: an alias such as
	// `std.debug_print` inherits it with nothing said twice.
	zero_parameters_effect_t : type = () -> u64
	_ : type = compiler.always_inline(zero_parameters_effect_t)
	_ : type = compiler.no_comptime(zero_parameters_effect_t)
	one_parameters_effect_t : type = (a : u64) -> u64
	_ : type = compiler.always_inline(one_parameters_effect_t)
	_ : type = compiler.no_comptime(one_parameters_effect_t)
	two_parameters_effect_t : type = (a : u64, b : u64) -> u64
	_ : type = compiler.always_inline(two_parameters_effect_t)
	_ : type = compiler.no_comptime(two_parameters_effect_t)
	immediate_effect_t : type = (immediate: comptime.u64) -> u64
	_ : type = compiler.always_inline(immediate_effect_t)
	_ : type = compiler.never_monomorphize(immediate_effect_t)
	_ : type = compiler.no_comptime(immediate_effect_t)
	branch_immediate_effect_t : type = (a: u64, immediate: comptime.u64) -> u64
	_ : type = compiler.always_inline(branch_immediate_effect_t)
	_ : type = compiler.never_monomorphize(branch_immediate_effect_t)
	_ : type = compiler.no_comptime(branch_immediate_effect_t)

	// The two crossings between a register and the entity behind it. Every
	// other reflection instruction below is plain `u64` in and `u64` out, so
	// these are the only two the type system has to say anything about:
	// `reflect` takes a `type` and hands back the entity id that was already
	// in the register, `unreflect_alias` turns an entity back into a name for
	// it (M-Flag's second half, and what makes a modifier a modifier).
	reflect_t : type = (T : type) -> u64
	_ : type = compiler.always_inline(reflect_t)
	_ : type = compiler.never_monomorphize(reflect_t)
	unreflect_alias_t : type = (e : u64) -> _
	_ : type = compiler.always_inline(unreflect_alias_t)
	_ : type = compiler.never_monomorphize(unreflect_alias_t)
	base_type_t : type = (size_bits : comptime.u64, align_bits : comptime.u64) -> type
	_ : type = compiler.always_inline(base_type_t)
	_ : type = compiler.never_monomorphize(base_type_t)
	// `standard.doir`'s `modifier_function` and `constructor_function`, which
	// share a signature - one edits and one allocates, and only the
	// instruction knows which.
	type_modifier_t : type = (T : type) -> type
	_ : type = compiler.always_inline(type_modifier_t)
	_ : type = compiler.never_monomorphize(type_modifier_t)
	type_query_t : type = (T : type) -> u64
	_ : type = compiler.always_inline(type_query_t)
	_ : type = compiler.never_monomorphize(type_query_t)
	// Asks a *field* rather than a type, so `u64` in rather than `type` in:
	// what the register carries is the field's entity, the same crossing
	// every reflection instruction below makes. Plain `u64` rather than a
	// `deduced` parameter matching the field's own type - which is what
	// S-Struct would want - because a `deduced` parameter gives the function
	// type a materialized parameter block, and a type carrying one does not
	// take `type_comptime`. Every type in this layer is 64 bits wide, so
	// there is nothing for S-Struct to reject here; a backend with narrower
	// registers would need the deduced form and the fix behind it.
	field_query_t : type = (field : u64) -> u64
	_ : type = compiler.always_inline(field_query_t)
	_ : type = compiler.never_monomorphize(field_query_t)
	type_with_number_t : type = (T : type, n : comptime.u64) -> type
	_ : type = compiler.always_inline(type_with_number_t)
	_ : type = compiler.never_monomorphize(type_with_number_t)
	// Asks an *entity* something - `argument_count` and `argument`, which
	// answer about a call rather than about a type. `n` is a plain `u64`
	// rather than `comptime.u64` so that an unroll's index can reach it
	// without a specialization per argument position.
	entity_query_t : type = (e : u64) -> u64
	_ : type = compiler.always_inline(entity_query_t)
	_ : type = compiler.never_monomorphize(entity_query_t)
	entity_with_number_t : type = (e : u64, n : u64) -> u64
	_ : type = compiler.always_inline(entity_with_number_t)
	_ : type = compiler.never_monomorphize(entity_with_number_t)

	// The block is comptime, but it is not decoration: `execute` and
	// `execute_if` hand it to the VM's own instruction, so it has to stay an
	// argument of the call. A comptime parameter that the callee *passes on* is
	// exactly the case for this marker.
	execute_t : type = (blk: block) -> u64
	_ : type = compiler.always_inline(execute_t)
	_ : type = compiler.never_monomorphize(execute_t)
	execute_if_t : type = (blk: block, condition: u64) -> u64
	_ : type = compiler.always_inline(execute_if_t)
	_ : type = compiler.never_monomorphize(execute_if_t)

	emit_register_t : type = (r : compiler.assembler.register) -> compiler.assembler.register
	_ : type = compiler.always_inline(emit_register_t)
	_ : type = compiler.never_monomorphize(emit_register_t)
	emit_register : emit_register_t = {
		%8 : compiler.pointer_sized = 8
		shift : compiler.pointer_sized = compiler.shift_right(r, %8)
		low : compiler.byte = compiler.truncate_to_byte(r)
		_ : compiler.byte = compiler.emit(low)
		high : compiler.byte = compiler.truncate_to_byte(shift)
		_ : compiler.byte = compiler.emit(high)
		_ : compiler.assembler.register = compiler.indicate_return(compiler.assembler.register)
	}


	// Named rather than written inline at each declaration, so that
	// `never_monomorphize` has something to be applied to: `T` is a comptime
	// parameter, and every copy of these would emit the same instruction with
	// one immediate changed.
	load_immediate_t : type = (T : type, v : T) -> T
	_ : type = compiler.never_monomorphize(load_immediate_t)
	immediate_op_t : type = (T : type) -> void
	_ : type = compiler.never_monomorphize(immediate_op_t)

	load_immediate : load_immediate_t = {}
	load_upper_immediate : load_immediate_t = {}
	// A Mizu immediate is 32 bits, so a value wider than that takes both
	// instructions - and `load_upper_immediate` on its own would encode the
	// *low* half of whatever it is handed, since the pass that expands it
	// truncates. These two do the pair, picking the halves apart themselves:
	// `load_u64_immediate` reads the value as an integer, `load_f64_immediate`
	// as the bit pattern of the double, which is what a float immediate is.
	load_u64_immediate : load_immediate_t = {}
	load_f64_immediate : load_immediate_t = {}
	label : () -> compiler.assembler.register = {}

	load_immediate_op : immediate_op_t = {
		%0 : compiler.byte_pointer = "\x06\x00\x00\x00\x00\x00\x00\x00"
		_ : compiler.byte = compiler.emit_bytes(%0)
		_ : T = compiler.indicate_return(T)
	}
	load_upper_immediate_op : immediate_op_t = {
		%1 : compiler.byte_pointer = "\x07\x00\x00\x00\x00\x00\x00\x00"
		_ : compiler.byte = compiler.emit_bytes(%1)
		_ : T = compiler.indicate_return(T)
	}
	label_op : () -> void = {
		%2 : compiler.byte_pointer = "\x01\x00\x00\x00\x00\x00\x00\x00"
		_ : compiler.byte = compiler.emit_bytes(%2)
		_ : void = compiler.indicate_return(void)
	}

	find_label_t : type = (label: compiler.assembler.register) -> u64
	_ : type = compiler.never_monomorphize(find_label_t)
	_ : type = compiler.always_inline(find_label_t)
	_ : type = compiler.no_comptime(find_label_t)
	find_label : find_label_t = {
		regret : compiler.assembler.register = compiler.assembler.return_register(u64)
		%3 : compiler.byte_pointer = "\x02\x00\x00\x00\x00\x00\x00\x00"
		_ : compiler.byte = compiler.emit_bytes(%3)
		_ : compiler.assembler.register = inline emit_register(regret)
		lowest : compiler.byte = compiler.truncate_to_byte(label)
		_ : compiler.byte = compiler.emit(lowest)
		%8 : compiler.pointer_sized = 8
		shift_8 : compiler.pointer_sized = compiler.shift_right(label, %8)
		low : compiler.byte = compiler.truncate_to_byte(shift_8)
		_ : compiler.byte = compiler.emit(low)
		%16 : compiler.pointer_sized = 16
		shift_16 : compiler.pointer_sized = compiler.shift_right(label, %16)
		high : compiler.byte = compiler.truncate_to_byte(shift_16)
		_ : compiler.byte = compiler.emit(high)
		%24 : compiler.pointer_sized = 24
		shift_24 : compiler.pointer_sized = compiler.shift_right(label, %24)
		highest : compiler.byte = compiler.truncate_to_byte(shift_24)
		_ : compiler.byte = compiler.emit(highest)
		%4 : compiler.byte_pointer = "\x00\x00"
		_ : compiler.byte = compiler.emit_bytes(%4)
		_ : u64 = compiler.indicate_return(u64)
	}

	debug_print : one_parameters_effect_t = {
