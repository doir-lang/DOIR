{
	"name": "doir",
	"description": "DOIR: a -betterC D compiler prototype built on Mizu, libECRS and libdiagnose",
	"license": "MIT",
	"targetType": "staticLibrary",
	"sourcePaths": [
		"source"
	],
	"importPaths": [
		"source"
	],
	"dependencies": {
		"mizu": {
			"repository": "git+https://github.com/doir-lang/Mizu.git",
			"version": "c424ac986979e95787eb4384a48b82dfe71bffae"
		},
		"libecrs": {
			"repository": "git+https://github.com/doir-lang/libECRS.git",
			"version": "804e6b3bb63b3c3263b6f6805c9efcd420b52044"
		},
		"libdiagnose": {
			"repository": "git+https://github.com/doir-lang/libdiagnose.git",
			"version": "f17ec44d653cf2b79ea5dd37e9f91f735e87a508"
		}
	},
	"dflags-ldc": [
		"-betterC",
		"-checkaction=C"
	],
	"dflags-dmd": [
		"-betterC",
		"-checkaction=C"
	],
	"configurations": [
		{
			"name": "library",
			"targetType": "staticLibrary",
			"excludedSourceFiles": [
				"source/main.d"
			]
		},
		{
			"name": "doir",
			"targetType": "executable",
			"targetPath": "bin",
			"targetName": "doir",
			"mainSourceFile": "source/main.d",
			"sourcePaths": [
				"source"
			],
			"importPaths": [
				"source"
			],
			"excludedSourceFiles": [
				"tools/mizu_gen.d"
			]
		},
		{
			"name": "mizu-gen",
			"targetType": "executable",
			"targetPath": "bin",
			"targetName": "mizu-gen",
			"mainSourceFile": "tools/mizu_gen.d",
			"sourcePaths": [
				"source",
				"tools"
			],
			"importPaths": [
				"source",
				"tools"
			],
			"excludedSourceFiles": [
				"source/main.d"
			]
		},
		{
			"name": "unittest",
			"targetType": "executable",
			"targetPath": "bin",
			"targetName": "doir-tests",
			"mainSourceFile": "tests/runner.d",
			"sourcePaths": [
				"source",
				"tests"
			],
			"importPaths": [
				"source",
				"tests"
			],
			"excludedSourceFiles": [
				"source/main.d"
			]
		}
	],
	"buildTypes": {
		"debug": {
			"buildOptions": [
				"debugMode",
				"debugInfo",
				"optimize"
			]
		},
		"unittest": {
			"buildOptions": [
				"unittests",
				"debugMode",
				"debugInfo",
				"optimize"
			]
		}
	}
}