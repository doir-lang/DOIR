{
	"name": "doir",
	"description": "DOIR: a -betterC D compiler prototype built on Mizu, libECRS and libdiagnose",
	"license": "MIT",
	"targetType": "staticLibrary",
	"sourcePaths": [
		"source"
	],
	"importPaths": [
		"source"
	],
	"dependencies": {
		"mizu": {
			"repository": "git+https://github.com/doir-lang/Mizu.git",
			"version": "f387b8fdb266c32a57fe1f02be3baccb44d75f78"
		},
		"libecrs": {
			"repository": "git+https://github.com/doir-lang/libECRS.git",
			"version": "ee436f3e51f9e1dcfd7a79fd811d23b96fd2328c"
		},
		"diagnose": {
			"repository": "git+https://github.com/doir-lang/libdiagnose.git",
			"version": "5fdbf538eb9694199c6dcd622683b150f09131f2"
		}
	},
	"dflags-ldc": [
		"-betterC",
		"-checkaction=C"
	],
	"dflags-dmd": [
		"-betterC",
		"-checkaction=C"
	],
	"configurations": [
		{
			"name": "library",
			"targetType": "staticLibrary",
			"excludedSourceFiles": [
				"source/main.d"
			]
		},
		{
			"name": "doir",
			"targetType": "executable",
			"targetPath": "bin",
			"targetName": "doir",
			"mainSourceFile": "source/main.d",
			"sourcePaths": [
				"source"
			],
			"importPaths": [
				"source"
			],
			"excludedSourceFiles": [
				"tools/mizu_gen.d"
			]
		},
		{
			"name": "mizu-gen",
			"targetType": "executable",
			"targetPath": "bin",
			"targetName": "mizu-gen",
			"mainSourceFile": "tools/mizu_gen.d",
			"sourcePaths": [
				"source",
				"tools"
			],
			"importPaths": [
				"source",
				"tools"
			],
			"excludedSourceFiles": [
				"source/main.d"
			]
		},
		{
			"name": "unittest",
			"targetType": "executable",
			"targetPath": "bin",
			"targetName": "doir-tests",
			"mainSourceFile": "tests/runner.d",
			"sourcePaths": [
				"source",
				"tests"
			],
			"importPaths": [
				"source",
				"tests"
			],
			"excludedSourceFiles": [
				"source/main.d"
			]
		}
	],
	"buildTypes": {
		"debug": {
			"buildOptions": [
				"debugMode",
				"debugInfo",
				"optimize"
			]
		},
		"unittest": {
			"buildOptions": [
				"unittests",
				"debugMode",
				"debugInfo",
				"optimize"
			]
		}
	}
}