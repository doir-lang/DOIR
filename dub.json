{
	"name": "doir",
	"description": "DOIR: a -betterC D compiler prototype built on Mizu, libECRS and libdiagnose",
	"license": "MIT",
	"targetType": "staticLibrary",
	"sourcePaths": [
		"source"
	],
	"importPaths": [
		"source"
	],
	"dependencies": {
		"mizu": {
			"repository": "git+https://github.com/doir-lang/Mizu.git",
			"version": "43028fe0e471971439e46b004435cbfcdc009637"
		},
		"libecrs": {
			"repository": "git+https://github.com/doir-lang/libECRS.git",
			"version": "0f73b9f39ce274f286ef0edd3ced48aa95d5bf06"
		},
		"diagnose": {
			"repository": "git+https://github.com/doir-lang/libdiagnose.git",
			"version": "c4699d756b151b004b44458c7f8e5d0913353fbc"
		}
	},
	"dflags-ldc": [
		"-betterC",
		"-checkaction=C"
	],
	"dflags-dmd": [
		"-betterC",
		"-checkaction=C"
	],
	"configurations": [
		{
			"name": "library",
			"targetType": "staticLibrary",
			"excludedSourceFiles": [
				"source/main.d"
			]
		},
		{
			"name": "doir",
			"targetType": "executable",
			"targetPath": "bin",
			"targetName": "doir",
			"mainSourceFile": "source/main.d",
			"sourcePaths": [
				"source"
			],
			"importPaths": [
				"source"
			],
			"excludedSourceFiles": [
				"tools/mizu_gen.d"
			]
		},
		{
			"name": "mizu-gen",
			"targetType": "executable",
			"targetPath": "bin",
			"targetName": "mizu-gen",
			"mainSourceFile": "tools/mizu_gen.d",
			"sourcePaths": [
				"source",
				"tools"
			],
			"importPaths": [
				"source",
				"tools"
			],
			"excludedSourceFiles": [
				"source/main.d"
			]
		},
		{
			"name": "unittest",
			"targetType": "executable",
			"targetPath": "bin",
			"targetName": "doir-tests",
			"mainSourceFile": "tests/runner.d",
			"sourcePaths": [
				"source",
				"tests"
			],
			"importPaths": [
				"source",
				"tests"
			],
			"excludedSourceFiles": [
				"source/main.d"
			]
		}
	],
	"buildTypes": {
		"debug": {
			"buildOptions": [
				"debugMode",
				"debugInfo",
				"optimize"
			]
		},
		"unittest": {
			"buildOptions": [
				"unittests",
				"debugMode",
				"debugInfo",
				"optimize"
			]
		}
	}
}