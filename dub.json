{
	"name": "doir",
	"description": "DOIR: a -betterC D compiler prototype built on Mizu, libECRS and libdiagnose",
	"license": "MIT",
	"targetType": "staticLibrary",
	"sourcePaths": [
		"source"
	],
	"importPaths": [
		"source"
	],
	"dependencies": {
		"mizu": {
			"repository": "git+https://github.com/doir-lang/Mizu.git",
			"version": "1df80d017c7ade5ded9a85c005a20f16879a3dd7"
		},
		"libecrs": {
			"repository": "git+https://github.com/doir-lang/libECRS.git",
			"version": "699e6431b0571a2089af282f0f05d2de7c323ada"
		},
		"diagnose": {
			"repository": "git+https://github.com/doir-lang/libdiagnose.git",
			"version": "6e785511f5db14548fd43395bac558c57aef5f3e"
		}
	},
	"dflags-ldc": [
		"-betterC",
		"-checkaction=C"
	],
	"dflags-dmd": [
		"-betterC",
		"-checkaction=C"
	],
	"configurations": [
		{
			"name": "library",
			"targetType": "staticLibrary",
			"excludedSourceFiles": [
				"source/main.d"
			]
		},
		{
			"name": "doir",
			"targetType": "executable",
			"targetPath": "bin",
			"targetName": "doir",
			"mainSourceFile": "source/main.d",
			"sourcePaths": [
				"source"
			],
			"importPaths": [
				"source"
			],
			"excludedSourceFiles": [
				"tools/mizu_gen.d"
			]
		},
		{
			"name": "mizu-gen",
			"targetType": "executable",
			"targetPath": "bin",
			"targetName": "mizu-gen",
			"mainSourceFile": "tools/mizu_gen.d",
			"sourcePaths": [
				"source",
				"tools"
			],
			"importPaths": [
				"source",
				"tools"
			],
			"excludedSourceFiles": [
				"source/main.d"
			]
		},
		{
			"name": "unittest",
			"targetType": "executable",
			"targetPath": "bin",
			"targetName": "doir-tests",
			"mainSourceFile": "tests/runner.d",
			"sourcePaths": [
				"source",
				"tests"
			],
			"importPaths": [
				"source",
				"tests"
			],
			"excludedSourceFiles": [
				"source/main.d"
			]
		}
	],
	"buildTypes": {
		"debug": {
			"buildOptions": [
				"debugMode",
				"debugInfo",
				"optimize"
			]
		},
		"unittest": {
			"buildOptions": [
				"unittests",
				"debugMode",
				"debugInfo",
				"optimize"
			]
		}
	}
}