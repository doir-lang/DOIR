
path : compiler.byte_pointer = "./mizu.doir" 
_ : _ = early_include(path)

// num = 5 (pinned to x1)
num : mizu.u64 = 5
_ : _ = mizu.load_immediate(mizu.u64, num)
_ : _ = compiler.assembler.pin_register(mizu.u64, num, mizu.x1)
// %1 = 1
%1 : mizu.u64 = 1
_ : _ = mizu.load_immediate(mizu.u64, %1)

// top:
top_addr : mizu.u64 = mizu.find_label(top)
top : compiler.assembler.register = mizu.label()
    // num = num + 1
    num_loop : mizu.u64 = mizu.add(num, %1)
    _ : _ = compiler.assembler.pin_register(mizu.u64, num_loop, mizu.x1)
    // print(num)
    _ : _ = mizu.debug_print(num_loop)
    // goto top
    _ : _ = mizu.jump_to(top_addr)
_ : _ = mizu.halt()